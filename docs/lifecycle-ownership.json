{
  "version": 21,
  "interfaces": {
    "callee_lifecycle": {
      "codex": "$prism-callee:lifecycle",
      "claude": "/prism-callee:lifecycle",
      "flat": "/prism-callee-lifecycle"
    }
  },
  "beads": {
    "membership_label": "prism",
    "approval_label": "human:approved",
    "story_phases": [
      "phase:story:specify",
      "phase:story:design",
      "phase:story:breakdown",
      "phase:story:human",
      "phase:story:apply",
      "phase:story:verify"
    ],
    "epic_phases": [
      "phase:epic:frame",
      "phase:epic:architecture",
      "phase:epic:roadmap",
      "phase:epic:approval",
      "phase:epic:delivery",
      "phase:epic:validation"
    ],
    "unsupported_phase_policy": "treat-as-absent-no-migration",
    "missing_phase_initialization": {
      "story": "phase:story:specify",
      "epic": "phase:epic:frame",
      "clear_approval": true
    },
    "hierarchy": {
      "epic_children": "story",
      "story_children": "task",
      "nested_epics": false,
      "direct_epic_tasks": false
    }
  },
  "routing": {
    "priority": [
      "explicit-open-epic-batch",
      "explicit-story-or-epic-id",
      "task-parent-story",
      "unambiguous-single-item-resume",
      "clear-multi-story-intent",
      "ordinary-story-intent"
    ],
    "open_epic_batch": {
      "selection": "one invocation-start snapshot of open epic items labeled prism",
      "order": [
        "priority",
        "created_at",
        "id"
      ],
      "visit": "exactly-once-sequential",
      "continue_after_item_local_stop": true,
      "rescan": false,
      "approval_transfer": false,
      "empty_snapshot": "report-and-create-nothing",
      "output": "one-outcome-row-per-snapshot-id"
    }
  },
  "approval": {
    "host_story_order": [
      "Design summary",
      "Task summary",
      "Approval request"
    ],
    "host_epic_order": [
      "Architecture summary",
      "Story roadmap",
      "Approval request"
    ],
    "host_acceptance_output": "explicit-request-only-complete-untruncated-current-item-only",
    "missing_acceptance": {
      "story": "phase:story:specify",
      "epic": "phase:epic:frame"
    },
    "epic_approval_cascades_to_stories": false
  },
  "child_graph": {
    "numeric_minimum": null,
    "numeric_maximum": null,
    "quality": [
      "coverage",
      "cohesion",
      "reviewability",
      "verifiability",
      "necessary-acyclic-dependencies"
    ],
    "one_child_can_pass": true,
    "more_than_twelve_can_pass": true,
    "incomplete_graph_fails": true,
    "separable_mega_item_fails": true
  },
  "surface_ownership": {
    "callee_lifecycle": {
      "canonical": "plugins/prism-callee/skills/lifecycle",
      "flat": "plugins/prism-callee/prefixed-skills/prism-callee-lifecycle",
      "owns": [
        "host-wrapper-for-story-and-epic-callee-workflow"
      ]
    },
    "direct_callee": {
      "root": "pack/callee/prism",
      "runner": "callee agent run prism/lifecycle --message \"$envelope\"",
      "input_contract": "internal-host-built-route-envelope",
      "graphs": [
        "story",
        "epic"
      ],
      "router": true,
      "authorized_behavior_change": "hierarchical Story/Epic routing, approval boundaries, and explicit open-Epic batches"
    }
  },
  "task_states": [
    {
      "state": "implementing",
      "assignee": "prism/apply/implementer"
    },
    {
      "state": "reviewing",
      "assignee": "prism/apply/reviewer"
    }
  ],
